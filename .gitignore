# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies — npm workspaces hoist to the root, but a package can still get
# its own tree when versions conflict.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
dist/
/coverage

# Environment. Real values never get committed; the documented templates do.
.env.*
!.env.example

# TypeScript
*.tsbuildinfo

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*



# Legacy: the project-local mongod that development used before everything
# moved to the hosted cluster. Kept ignored so an old working copy does not
# suddenly try to commit 488MB of WiredTiger files.
.localdb/
