{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noFallthroughCasesInSwitch": true,

    // `noUncheckedIndexedAccess` and `verbatimModuleSyntax` are deliberately off
    // here. The 119 screens under src/pages were authored against the
    // prototype's compiler settings; mechanically inserting ~200 non-null
    // assertions to satisfy flags they were never written for would add noise
    // and risk without adding safety. The server — where the correctness
    // stakes actually are, and which is entirely first-party code — keeps both.
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": false,

    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
