# ─────────────────────────────────────────────────────────────────────────────
# Access Genie web client — environment
#
#   cp .env.example .env
#
# Only variables prefixed VITE_ reach the browser. They are inlined into the
# bundle at build time, so never put a secret here — this file is public by
# construction.
# ─────────────────────────────────────────────────────────────────────────────

# Where the dev server listens.
VITE_PORT=5173
# Where `vite preview` serves the production build.
VITE_PREVIEW_PORT=4173

# Base URL the client calls.
#
# A relative path is the right default: requests then go through the dev proxy
# below (or your reverse proxy in production) and share the app's origin, which
# makes the refresh cookie first-party and avoids a CORS preflight on every call.
# Must match the API's API_PREFIX.
VITE_API_URL=/api/v1

# Where the dev server forwards /api and /health — the Express API.
VITE_API_PROXY=http://localhost:4000

# Set this only when the API is served from a different origin in production and
# you are not putting a reverse proxy in front of both. It replaces VITE_API_URL
# with an absolute URL, and then the API's CORS_ORIGIN must name this app's
# origin and COOKIE_SAME_SITE must be `none` with COOKIE_SECURE on.
# VITE_API_URL=https://api.example.com/api/v1

# Request timeout in milliseconds.
VITE_API_TIMEOUT=20000

# Password the login screen's account shortcuts prefill.
#
# Left empty on purpose: the default seeder creates one real administrator, and
# this value is inlined into the public bundle. Empty means the shortcut fills
# the email and you type the password — which is what you want anywhere the
# account is real. Set it (to the API's ADMIN_PASSWORD, or to SEED_PASSWORD if
# you loaded the demo fixtures) only for a throwaway demo environment.
VITE_DEMO_PASSWORD=
