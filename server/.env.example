# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# Leave MONGODB_URI empty in development to boot a throwaway in-memory MongoDB
# (mongodb-memory-server). Set it for anything you want to persist.
MONGODB_URI=mongodb://127.0.0.1:27017/access_genie
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/access_genie

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Seed ─────────────────────────────────────────────────────────────────────
# Password given to every seeded demo persona.
SEED_PASSWORD=Genie@2026
