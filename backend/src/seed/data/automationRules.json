      "Assign to IoT Platform",
      "Mark dependent zones unverifiable"
    ],
    "priority": "P1",
    "assignTeam": "IoT Platform",
    "escalateAfterMin": 120,
    "enabled": true,
    "firedToday": 1,
    "suppressedToday": 2
