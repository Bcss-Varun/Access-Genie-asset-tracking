    "then": [
      "Raise P3",
      "Batch into the next swap round"
    ],
    "priority": "P3",
    "assignTeam": "IoT Platform",
    "escalateAfterMin": 4320,
    "enabled": true,
    "firedToday": 2,
    "suppressedToday": 6
