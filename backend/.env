# ─────────────────────────────────────────────────────────────────────────────
# Access Genie API — environment
#
#   cp .env.example .env   and fill in MONGODB_URI + the two JWT secrets.
#
# Every value is validated at boot by src/config/env.ts; a missing or malformed
# one stops the process with a readable message instead of failing later.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Interface to bind. 0.0.0.0 accepts external traffic; 127.0.0.1 does not.
HOST=0.0.0.0
# Version prefix every route is mounted under. The client's VITE_API_URL must agree.
API_PREFIX=/api/v1
# debug | info | warn | error. Defaults to debug outside production.
# LOG_LEVEL=debug

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to send credentialed requests.
# In development this is the Vite dev server; in production, your web origin.
CORS_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# The hosted cluster — the one place application state lives. There is no local
# database any more: users, sessions, assets, work orders, alerts, the audit
# trail and each person's saved views and theme are all documents here, so any
# instance of the API can serve any request.
#
# It needs this machine's current public IP on the Atlas access list (and, for
# the deployed API, 0.0.0.0/0 or the platform's egress range).
MONGODB_URI=mongodb+srv://varunadapa_db_user:vtqNl7wIQA9V70vl@cluster0.fp4vukf.mongodb.net
# Previous cluster, kept for reference:
# MONGODB_URI=mongodb+srv://varunadapa_db_user:ViU5r7E16DV1e32C@cluster0.kjcizwb.mongodb.net/?appName=Cluster0
#
# Set the database name explicitly. An Atlas connection string is usually pasted
# without a path, and Mongoose would then quietly connect to a database called
# "test" — this is the variable that stops that happening, and the one to change
# to point staging and production at the same cluster.
MONGODB_DB_NAME=access_genie_demo
# Ten, not one. Every read path in this API fans out with `Promise.all` — the
# dataset payload issues ~60 queries, the dashboard summary ~40 — and a pool of
# one turns every one of those fan-outs back into a sequential loop. That single
# character was most of the dashboard's cold-start time.
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# They must differ from each other, and the server refuses to start in
# production while they still say "change-me".
JWT_ACCESS_SECRET=f1aca884f02fec11750123d3da3ec062ed9c588825ae846bc11ab37bacbb337e11aa45109eace1bb03404e08522208d1
JWT_REFRESH_SECRET=8bdc1fc17aae3dec655ee4c7dc6cbf56411a30ef331a06649e2a37dded08412cc89494e77b80721cd2da5619af5b9843
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Password hashing cost. Higher is slower to crack and slower to sign in.
BCRYPT_ROUNDS=10

# ── Refresh cookie ───────────────────────────────────────────────────────────
COOKIE_NAME=ag_refresh
# Leave unset for a host-only cookie — correct unless you serve subdomains.
# COOKIE_DOMAIN=.example.com
# Defaults to on in production. Must be on wherever the app is served over HTTPS.
# COOKIE_SECURE=false
# strict | lax | none. Defaults to strict in production, lax otherwise.
# Use `none` (with COOKIE_SECURE=true) only when the API and the client are on
# genuinely different sites.
# COOKIE_SAME_SITE=lax

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
# Requests per window. Defaults to 300 in production, 10000 otherwise.
# RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Failed sign-in attempts per window. Defaults to 10 in production, 100 otherwise.
# AUTH_RATE_LIMIT_MAX=10

# ── Seed ─────────────────────────────────────────────────────────────────────
# `npm run seed` creates this administrator and nothing else.
ADMIN_EMAIL=raj@bcss.in
ADMIN_PASSWORD=raj@bcss
ADMIN_NAME=Raj
ADMIN_ORG_NAME=Access Genie

# Only used by the opt-in demo seeder (`npm run seed:demo`).
SEED_PASSWORD=admin123
