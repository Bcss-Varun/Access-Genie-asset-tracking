# Replace the hostname, TLS paths and frontend build directory before use.
server {
    listen 443 ssl;
    server_name assets.example.com;
    ssl_certificate /etc/ssl/access-genie/fullchain.pem;
    ssl_certificate_key /etc/ssl/access-genie/privkey.pem;
    root /srv/access-genie/frontend/dist;
    index index.html;
    client_max_body_size 8m;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location = /health {
        proxy_pass http://127.0.0.1:4000;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
server {
    listen 80;
    server_name assets.example.com;
    return 301 https://assets.example.com$request_uri;
}
